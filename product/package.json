{
  "name": "agent-coordination-platform",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node ../setup.mjs",
    "start": "node src/server.js",
    "start:local": "node --env-file=.env src/server.js",
    "build": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "import": "node src/import.js",
    "test:compose": "node test/compose-acceptance.js",
    "diagnostics": "node src/operations.js diagnostics",
    "setup:agent": "node src/setup.js",
    "setup:global": "node src/global-setup.js",
    "setup:operator": "node src/operator-setup.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3"
  }
}
